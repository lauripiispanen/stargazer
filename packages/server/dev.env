# Environment for `npm run dev`: the server talks to the local simulator and keeps its state in the repo's
# .dev/ directory instead of ~/.stargazer. Paths are relative to packages/server. All options: src/config.ts.
TELESCOPE_HOST=127.0.0.1
STARGAZER_STATE_FILE=../../.dev/state.json
STARGAZER_PACKET_LOG=../../.dev/packets.log
